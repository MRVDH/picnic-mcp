{
  "name": "picnic-mcp",
  "mcpName": "io.github.MRVDH/picnic-mcp",
  "version": "1.0.0",
  "description": "MCP server for the online supermarket Picnic: search products, fill the cart and pick a delivery slot",
  "keywords": [
    "picnic",
    "mcp",
    "model-context-protocol",
    "supermarket",
    "groceries"
  ],
  "homepage": "https://github.com/MRVDH/picnic-mcp",
  "bugs": {
    "url": "https://github.com/MRVDH/picnic-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MRVDH/picnic-mcp.git"
  },
  "license": "MIT",
  "author": "Maarten van den Hoven <info@maartenvandenhoven.com> (https://maartenvandenhoven.com)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/**"
  ],
  "bin": {
    "picnic-mcp": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bundle": "bash scripts/bundle.sh",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "picnic-api": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
